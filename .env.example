# .env.example — plantilla de variables de entorno.
#
# Copia este fichero a `.env` y rellena los valores:  cp .env.example .env
# `.env` está en .gitignore. NUNCA lo commitees.
#
# Esta lista se deriva de lo que el código lee de verdad
# (`grep -rhoE 'process\.env\.[A-Z_]+' server/`), no de lo que diga un documento.
# Si añades un `process.env.X` nuevo al servidor, añádelo aquí.

# ─── Supabase ──────────────────────────────────────────────────────────────
# Obligatorias. El servidor usa service_role (bypasa RLS); el cliente, anon.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ─── Auth ──────────────────────────────────────────────────────────────────
# JWT_SECRET es obligatoria.
# JWT_REFRESH_SECRET es opcional: si falta, el refresh token se firma con
# JWT_SECRET (server/routes/auth.js). En producción, ponle un valor distinto.
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─── Email (Resend) ────────────────────────────────────────────────────────
# Obligatorias: sin ellas el servidor NO arranca (validateSmtpConfig en
# server/utils/smtpConfig.js hace process.exit(1)).
RESEND_API_KEY=
SMTP_FROM=noreply@tudominio.com
SMTP_USER=

# ─── Digests (cron diario) ─────────────────────────────────────────────────
DIGEST_TO=admin@tudominio.com
DIGEST_HOUR=6
DIGEST_MINUTE=0
ADMIN_DIGEST_HOUR=
USER_DIGEST_HOUR=7
USER_DIGEST_MINUTE=0

# Secreto que autentica el trigger de GitHub Actions contra /api/digest/cron-trigger.
# Debe coincidir en Railway y en los GitHub Secrets.
DIGEST_CRON_SECRET=genera-un-secreto-largo-aqui

# ─── Riel de comandas ──────────────────────────────────────────────────────
# Autentica POST /api/internal/create-card (header x-task-secret). Sin JWT ni
# login: quien tenga este secreto, escribe. Genera uno largo:
#   openssl rand -hex 32
TASK_SECRET=

# ─── App ───────────────────────────────────────────────────────────────────
PORT=3003
SITE_URL=https://kanban.aglaya.biz
NODE_ENV=production

# ─── Observabilidad (opcional) ─────────────────────────────────────────────
# Sin SENTRY_DSN, Sentry queda desactivado y el servidor arranca igual.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
GIT_SHA=

# ─── Solo para scripts puntuales ───────────────────────────────────────────
# No la lee la app: la usa server/scripts/migrate-myboard.js.
# WORKSPACE_ID=
