# ── Puerto del servidor ───────────────────────────────────────────────────────
PORT=3003

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_publica
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_PRIVADA  # nunca exponer al cliente
JWT_SECRET=your-random-secret-min-32-chars

# ── SMTP (Resend en producción) ────────────────────────────────────────────────
SMTP_HOST=your-smtp-host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="AGLAYA Kanban Desk <kanban@aglaya.biz>"

# ── Digest (Admin) ────────────────────────────────────────────────────────────
# Recipient email para admin digest (estadísticas globales)
DIGEST_TO=email@tudominio.com
# Hora del día (0-23 en tu timezone local) cuando se envía el digest admin
# Default: 7 (7 AM). IMPORTANTE: debe ser diferente a USER_DIGEST_HOUR
DIGEST_HOUR=7

# ── Digest (User) ─────────────────────────────────────────────────────────────
# Hora del día (0-23 en tu timezone local) cuando se envía digest a todos los usuarios
# Default: 8 (8 AM). IMPORTANTE: debe ser diferente a DIGEST_HOUR para evitar pico SMTP
USER_DIGEST_HOUR=8
# URL base del app (usado en CTAs del email)
SITE_URL=https://kanban.aglaya.biz
