# AGLAYA Kanban Desk — MCP rail configuration.
#
# Copy these into a secret file the captain never sees. Preferred location:
#   ~/.config/aglaya/kanban-rail.env   (chmod 600)
# OR export them as env vars in the MCP process. NEVER commit real values.
#
# The rail logs in as a dedicated superadmin SERVICE ACCOUNT (not a person).

# API login (escrituras — heredan validación + notificaciones del server)
KANBAN_API_URL=https://kanban.aglaya.biz/api
KANBAN_RAIL_EMAIL=kanban-rail@aglaya.biz
KANBAN_RAIL_PASSWORD=

# PostgREST (solo lecturas que la API no expone: column→board, checklist)
KANBAN_SUPABASE_URL=https://<project>.supabase.co
