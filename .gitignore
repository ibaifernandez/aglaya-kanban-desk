# ── Dependencias ──────────────────────────────────────────
node_modules/
client/node_modules/

# ── Variables de entorno — NUNCA subir al repo ────────────
.env
.env.local
.env.production
client/.env
client/.env.local
client/.env.production

# ── Datos personales y backups ────────────────────────────
server/data/tasks.personal-backup.json
server/uploads/*
!server/uploads/.gitkeep

# ── Builds ────────────────────────────────────────────────
client/dist/
dist/

# ── Logs ──────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Sistema operativo ─────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDEs ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Supabase CLI temp data ────────────────────────────────
supabase/.temp/
supabase/.branches/

# ── Claude Code runtime (local-only) ──────────────────────
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/worktrees/

# ── Graphify output (commit graph + report only) ──────────
graphify-out/*
!graphify-out/graph.json
!graphify-out/REPORT.md
!graphify-out/graph.html
!graphify-out/.graphify_analysis.json
