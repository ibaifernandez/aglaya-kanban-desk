# ── Dependencias ──────────────────────────────────────────
node_modules/
client/node_modules/

# ── Variables de entorno — NUNCA subir al repo ────────────
.env
.env.local
.env.production
client/.env
client/.env.local
client/.env.production

# ── Datos personales y backups ────────────────────────────
server/data/tasks.personal-backup.json
server/uploads/*
!server/uploads/.gitkeep

# ── Builds ────────────────────────────────────────────────
client/dist/
dist/

# ── Logs ──────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Sistema operativo ─────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDEs ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Supabase CLI temp data ────────────────────────────────
supabase/.temp/
supabase/.branches/

# ── Claude Code runtime (local-only) ──────────────────────
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/worktrees/
.claude/handoffs/

# ── Graphify output — derivado, nunca versionado ──────────
# Decisión de flota: ningún repo guarda su grafo. Nada del código lee uno, y un
# derivado commiteado envejece con pinta de autoridad — se lee como el estado de
# la codebase cuando es una foto del día que se construyó. El grafo se corre a
# demanda (`graphify update .`) y vive solo en local.
graphify-out/

# Local Netlify folder
.netlify

# Documentos de trabajo del Operador (Pages). No son fuente ni entregable
# versionado: se generan, se editan a mano y pesan. Fuera del árbol.
*.pages
